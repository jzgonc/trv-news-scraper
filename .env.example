# Copy to .env and fill in. Never commit .env.
# Put values containing $ or spaces in 'single quotes'. No comments after values.

# --- SMTP (secondary domain) ---
SMTP_HOST=smtp.example.org
# starttls | ssl
SMTP_SECURITY=starttls
# Empty = 587 for starttls, 465 for ssl
SMTP_PORT=
SMTP_USER=news@example.org
SMTP_PASSWORD='change-me'
SMTP_FROM='TRV News <news@example.org>'

# --- Recipients (several addresses: comma-separated) ---
MAIL_TO_REDAKTION=redaktion@example.org
MAIL_TO_OFFICE=office@example.org
# Failure summaries; leave empty to disable
MAIL_TO_ADMIN=admin@example.org

# --- Nextcloud public share link (upload/edit rights) ---
NEXTCLOUD_SHARE_URL=https://cloud.example.org/s/AbCdEfGhIjKlMnO
NEXTCLOUD_SHARE_PASSWORD=''
NEXTCLOUD_BASE_FOLDER=News
# auto | new (Nextcloud >= 29, /public.php/dav) | legacy (/public.php/webdav)
NEXTCLOUD_DAV=auto

# --- Behaviour ---
# New articles are processed only once they are at least this old
MIN_AGE_MINUTES=60
# Local runs only; Docker always uses /data (= ./data on the host)
DATA_DIR=data
